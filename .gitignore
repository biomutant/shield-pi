# Release archives belong in GitHub Releases, not source history
milestones/releases/*.zip
milestones/rollback/*.zip

# Personal visual references and CRT photos stay in the private archive
assets/crt-reference/
assets/approved/

# Keep public documentation and milestone notes tracked
!docs/
!milestones/
